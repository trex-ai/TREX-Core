# Stack identity
ENVIRONMENT=local

# Image tags
EMQX_IMAGE_TAG=5.10.3
PROMETHEUS_IMAGE_TAG=v3.10.0
CADVISOR_IMAGE_TAG=latest

# Host exposure (loopback only by default)
MQTT_BIND_ADDRESS=127.0.0.1
MQTT_PORT=1883
EMQX_DASHBOARD_BIND_ADDRESS=127.0.0.1
EMQX_DASHBOARD_PORT=18083
PROMETHEUS_BIND_ADDRESS=127.0.0.1
PROMETHEUS_PORT=9090

# EMQX bootstrap
# This seeds the initial admin password on first boot only.
EMQX_DASHBOARD_DEFAULT_PASSWORD=change-me-before-first-boot

# Broker limits
EMQX_MAX_CONNECTIONS=2048
EMQX_MAX_QOS_ALLOWED=2
EMQX_RETAIN_AVAILABLE=true
EMQX_WILDCARD_SUBSCRIPTION=true
EMQX_SHARED_SUBSCRIPTION=true
EMQX_EXCLUSIVE_SUBSCRIPTION=false
EMQX_MAX_INFLIGHT=64
EMQX_RETRY_INTERVAL=30s
EMQX_MAX_AWAITING_REL=1000
EMQX_AWAIT_REL_TIMEOUT=300s
EMQX_MAX_MQUEUE_LEN=5000
EMQX_MQUEUE_STORE_QOS0=true

# File-descriptor policy
MQTT_NOFILE_SOFT=65536
MQTT_NOFILE_HARD=65536

# Container resource defaults
MQTT_CPUS=1.0
MQTT_MEM_LIMIT=1g
PROMETHEUS_CPUS=0.50
PROMETHEUS_MEM_LIMIT=512m
CADVISOR_CPUS=0.25
CADVISOR_MEM_LIMIT=256m
VOLUME_METRICS_CPUS=0.10
VOLUME_METRICS_MEM_LIMIT=128m






# ------------------------------------------------------------------------------
# PostgreSQL container
# ------------------------------------------------------------------------------
POSTGRES_IMAGE_TAG=18.3-bookworm
POSTGRES_BIND_ADDRESS=127.0.0.1
POSTGRES_PORT=5432
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=postgres
POSTGRES_INITDB_ARGS=--data-checksums
POSTGRES_HOST=postgres
POSTGRES_CONTAINER_NAME=trex-postgres
POSTGRES_CPUS=2.0
POSTGRES_MEM_LIMIT=2g

# ------------------------------------------------------------------------------
# Folder-driven bootstrap controller
# ------------------------------------------------------------------------------
POSTGRES_BOOTSTRAP_CONTROL_DB=postgres
POSTGRES_BOOTSTRAP_SCHEMA=trex_bootstrap
POSTGRES_BOOTSTRAP_INTERVAL_SECONDS=30

# ------------------------------------------------------------------------------
# pgAdmin
# pgAdmin 9.13 is current as of 2026-03-06. Pin 9.12 instead if you need to hold
# the earlier written baseline from the requirements document.
# ------------------------------------------------------------------------------
PGADMIN_IMAGE_TAG=9.13
PGADMIN_BIND_ADDRESS=127.0.0.1
PGADMIN_PORT=5050
PGADMIN_DEFAULT_EMAIL=admin@example.com
PGADMIN_DEFAULT_PASSWORD=change-me-pgadmin
PGADMIN_LISTEN_PORT=5050
PGADMIN_CPUS=1.0
PGADMIN_MEM_LIMIT=512m

# ------------------------------------------------------------------------------
# TREX-facing database settings.
# Default values below are for the migration phase while TREX still runs on the
# host and connects through the container's loopback-published port.
#
# When TREX itself is containerized later, switch these to:
#   TREX_DB_HOST=postgres
#   TREX_DB_PORT=5432
# ------------------------------------------------------------------------------
TREX_DB_HOST=127.0.0.1
TREX_DB_PORT=5432
TREX_DB_CONNECTOR=postgresql+psycopg
TREX_PROFILES_DB=citylearn_2022
TREX_DB_USERNAME=trex
TREX_DB_PASSWORD=change-me-postgres
